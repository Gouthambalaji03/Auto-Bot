# AutoBot Environment Variables
# Copy this file to .env and fill in your values

# ── Gemini API Key ──────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── PostgreSQL Database URL ─────────────────────────────────────
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=

# ── FastAPI Server (api_server.py) ──────────────────────────────
# Port and host for the REST API (default: 0.0.0.0:8000)
API_PORT=8000
API_HOST=0.0.0.0

# Comma-separated allowed CORS origins. Use * for development (allow all).
# For production, set to your frontend domain: https://yourdomain.com
CORS_ORIGINS=*

# ── Gemini Model ────────────────────────────────────────────────
# Model ID to use for the Pydantic AI agent (default: gemini-3.6-flash).
GEMINI_MODEL=gemini-3.6-flash

# ── Logging ──────────────────────────────────────────────────────
# Controls verbosity of the API server logs.
# DEBUG   → everything including DB persist steps and health polls
# INFO    → normal operation (requests, auth, chat events)  ← recommended for dev
# WARNING → only unexpected conditions
# ERROR   → only failures
LOG_LEVEL=INFO
